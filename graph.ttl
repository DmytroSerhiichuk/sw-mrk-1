<http://example.org/mkr/flight/FL-9269> a ex:BudgetFlight,
        ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Madrid> ;
    ex:departsFrom <http://example.org/mkr/city/Lisbon> ;
    ex:departureDate "2026-03-27"^^xsd:date ;
