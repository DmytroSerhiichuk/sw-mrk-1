<http://example.org/mkr/flight/FL-5698> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Krakow> ;
    ex:departsFrom <http://example.org/mkr/city/Odesa> ;
    ex:departureDate "2026-05-16"^^xsd:date ;
