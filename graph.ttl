ex:fromBusyCountry a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:boolean .

ex:locatedIn a rdf:Property ;
    rdfs:domain ex:City ;
    rdfs:range ex:Country .

ex:operatedBy a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:Airline .

ex:priceEur a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:decimal .

ex:reportedBy a rdf:Property ;
    rdfs:domain rdf:Statement ;
    rdfs:range rdfs:Resource .

<http://example.org/mkr/stmt/FL-1469-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 40 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-1469> .

<http://example.org/mkr/stmt/FL-3848-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 25 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-3848> .

<http://example.org/mkr/stmt/FL-8336-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 10 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-8336> .

<http://example.org/mkr/stmt/FL-8491-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/PassengerReport> ;
    rdf:object 15 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-8491> .

